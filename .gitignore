# Dependencies
node_modules/

# Environment files - never commit these.
# .env.example files are tracked on purpose so the required keys are documented.
# .env.test is tracked too: it holds no secrets - every provider in it is mock or
# local - and `npm test` needs it present, or the suite falls back to the real
# .env and starts calling real services.
.env
.env.*
!.env.example
!.env.test

# Build output
dist/
dist-ssr/
build/
*.local

# Credentials and keys (Google Cloud service account JSON, TLS keys, etc.)
*.pem
*.key
*-service-account*.json
gcp-*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches and coverage
.vite/
.cache/
coverage/
*.tsbuildinfo

# Generated audio kept locally during development
tmp/
uploads/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
*.swp
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini
