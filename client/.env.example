# Copy this file to client/.env and adjust if needed.
# client/.env is git-ignored.
#
# WARNING: Vite inlines every VITE_ variable into the public JavaScript bundle.
# Anything here is visible to anyone who opens browser devtools.
# Never put secrets, API keys or database URIs in this file.
#
# In production this is set in the Vercel project settings. Because Vite inlines
# it at BUILD time, changing it requires a redeploy - not just a restart.

# Base URL of the API server, with no trailing slash.
#   Local:       http://localhost:4000   (must match PORT in server/.env)
#   Production:  https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:4000
