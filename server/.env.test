# Test environment. Loaded by `npm test` (--env-file=.env.test) and by
# config/env.js when NODE_ENV=test. The real .env is never read during a test run.
#
# THIS FILE IS COMMITTED AND MUST STAY SECRET-FREE.
# Every provider below is local or mock, so nothing here can reach a real
# service, spend money, or send mail. Never paste a real key into this file - put
# it in .env, which is git-ignored.

NODE_ENV=test

# Host only. Each test file connects with its own dbName (tts-saas-test-auth,
# tts-saas-test-tts, ...) because `node --test` runs files in parallel processes,
# so the database named here is not the one the tests use.
MONGODB_URI=mongodb://127.0.0.1:27017/tts-saas-test

# Not a secret: it signs tokens that exist only inside a test run, and the value
# is public in this file by design. The real one lives in .env.
JWT_SECRET=test-only-jwt-secret-not-a-real-secret-0000000000

# bcrypt at the production cost of 12 takes hundreds of milliseconds per hash and
# would dominate the run. 4 is the schema minimum.
BCRYPT_COST=4

# The suite fires hundreds of requests from one address, which a limiter would
# reject instead of the code under test.
RATE_LIMIT_ENABLED=false

# --- providers: all local, none of them leave the machine --------------------

# 'log' prints the verification/reset link to the server log, which is where
# auth.test.js's captureEmailedToken() reads the token from. LOG_LEVEL is left at
# its 'info' default on purpose: at 'error' that line is suppressed and every
# email-verification test loses its token.
EMAIL_PROVIDER=log

# An audible tone of the right length, generated in-process. Exercises the whole
# credit path - reserve, charge, refund, storage round trip - with no provider.
TTS_PROVIDER=mock

# Local order ids and a webhook signed with the same secret the server verifies
# with, so the grant path is tested for real without moving money.
PAYMENT_PROVIDER=mock

# Files under GENERATED_AUDIO_DIR (tmp/audio, git-ignored). No bucket, no S3.
STORAGE_PROVIDER=local
