# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored and must never be committed.
#
# In production these are set in the Render dashboard, not in a file.
# See docs/DEPLOYMENT.md.

# development | test | production
NODE_ENV=development

# Port the API listens on.
# Render injects its own PORT and the server uses whatever it is given, so this
# only matters locally.
PORT=4000

# MongoDB connection string. Required - the server has no default.
#   Local:  mongodb://127.0.0.1:27017/tts-saas
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tts-saas?retryWrites=true&w=majority
# URL-encode any special characters in the password (@ becomes %40).
MONGODB_URI=mongodb://127.0.0.1:27017/tts-saas

# The canonical frontend origin (no trailing slash). Used for CORS now, and for
# links in emails from Phase 3.
#   Local:       http://localhost:5173
#   Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Optional. Extra browser origins allowed through CORS, comma-separated.
# Exists for Vercel preview deployments, which get a new hostname per branch:
#   CORS_EXTRA_ORIGINS=https://tts-saas-git-my-branch-you.vercel.app
# Leave empty locally.
CORS_EXTRA_ORIGINS=

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signs access tokens. Required, with no fallback: anyone who knows this value
# can mint a token for any account, including an admin one.
# Generate a fresh one per environment - never reuse your local value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it invalidates every access token, which is the emergency lever if
# it ever leaks.
JWT_SECRET=

# How long an access token stays valid. Short by design - these cannot be
# revoked, so this window is also how long a stolen one keeps working.
ACCESS_TOKEN_TTL=15m

# How long a session can go unused before the user has to sign in again.
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt work factor. Higher is slower to hash and slower to crack. 12 is a
# reasonable default; do not lower it in production to make logins feel faster.
BCRYPT_COST=12

# How long emailed links stay valid, in minutes. 1440 = 24 hours.
VERIFY_TOKEN_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# log    - prints the email, link included, to the server log. Right for local
#          development: no domain, no DNS records, no API key needed. Copy the
#          link out of your terminal.
# resend - actually delivers it. Requires RESEND_API_KEY.
EMAIL_PROVIDER=log

# Sender address. onboarding@resend.dev works without a domain but can only
# deliver to your own Resend account's address. Real delivery needs your own
# verified domain with SPF and DKIM records.
EMAIL_FROM=AI Text-to-Speech <onboarding@resend.dev>

# Only needed when EMAIL_PROVIDER=resend. This is a secret - it belongs here and
# in the Render dashboard, never in client/.env.
RESEND_API_KEY=

# Optional override for the refresh cookie's SameSite attribute.
# Leave blank: it resolves to 'lax' in development and 'none' in production,
# which is what a Vercel client talking to a Render API needs. Set it to 'lax'
# only if you later serve both from one domain. See config/cookies.js.
COOKIE_SAMESITE=

# ---------------------------------------------------------------------------
# Speech generation
# ---------------------------------------------------------------------------

# mock   - a real, playable WAV (a two-tone chime) generated on this machine.
#          Right for local development: the credit reserve, the refund, the
#          storage round trip and the player are all exercised for real, with no
#          billing account and no network call. It is obviously not speech, which
#          is deliberate - a convincing mock is one you ship by accident.
# google - calls Google Cloud Text-to-Speech. Requires
#          GOOGLE_SERVICE_ACCOUNT_JSON, and costs money per character.
# elevenlabs - calls ElevenLabs. Requires ELEVENLABS_API_KEY, and spends real
#          ElevenLabs credits per generation. For development and testing.
#          Switching provider changes which voices exist, so re-run
#          `npm run seed` afterwards - the seeder retires the voices the live
#          provider does not offer, and adds the ones it does.
TTS_PROVIDER=mock

# An ElevenLabs API key, needed only when TTS_PROVIDER=elevenlabs.
# Get one from https://elevenlabs.io -> profile -> API keys.
#
# This is a secret. It belongs here and nowhere else - never in client/.env
# (anything VITE_-prefixed is compiled into the bundle and readable by anyone who
# opens the page) and never in git. The server sends it in the xi-api-key header
# and never forwards it: the browser talks to this API, this API talks to
# ElevenLabs.
ELEVENLABS_API_KEY=

# A Google Cloud service-account key, needed only when TTS_PROVIDER=google.
#
# This is a private key. It belongs here and in the Render dashboard, never in
# client/.env and never in git. Paste either the whole JSON on one line, or its
# base64 form, which survives copy-paste and dashboard forms better:
#   node -e "console.log(require('fs').readFileSync('key.json','base64'))"
#
# The server never hands this or any Google token to the browser: the client
# talks only to this API, and this API talks to Google.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Where generated audio is kept. Audio is never stored in MongoDB - see
# docs/DECISIONS.md.
#
# local - files under GENERATED_AUDIO_DIR. Right for development, and wrong for
#         Render: the disk is ephemeral, so every deploy takes the audio and
#         leaves the Generation rows pointing at nothing.
# s3    - any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
#         This is the permanent one. Needs the S3_* values below.
STORAGE_PROVIDER=local

# Directory for generated audio, relative to the server package. Git-ignored.
# On a host with an ephemeral filesystem (Render's free plan included) this
# empties on every deploy and restart, so treat the files as a cache, not as
# storage you can rely on. The Generation record is the durable part.
GENERATED_AUDIO_DIR=tmp/audio

# Largest request Google will accept, in UTF-8 BYTES, not characters. Google's
# own ceiling is 5000; this sits under it. Bytes and characters differ for any
# non-ASCII text - "café" is 4 characters and 5 bytes, and Hindi or Japanese run
# roughly three bytes per character. Credits are charged per CHARACTER, so a
# Hindi user is not billed three times for the same sentence.
TTS_MAX_INPUT_BYTES=4800

# ---------------------------------------------------------------------------
# Permanent audio storage (only when STORAGE_PROVIDER=s3)
# ---------------------------------------------------------------------------
# Any S3-compatible bucket works; there is no AWS SDK involved, just signed
# HTTPS requests. Cloudflare R2 is the cheapest option for this workload because
# it charges nothing for egress, and audio is all egress.
#
# The bucket must be PRIVATE. Audio is served through GET /api/generations/:id/audio
# after an ownership check - a public bucket would make every generation
# readable by anyone who guesses a key.

# Required when STORAGE_PROVIDER=s3.
S3_BUCKET=

# AWS needs the bucket's real region (us-east-1, ap-south-1, ...).
# Cloudflare R2 wants the literal string `auto`. B2 and MinIO ignore it, but
# SigV4 still has to sign something, so it is never left blank.
S3_REGION=auto

# Blank means real AWS S3. Set it for anything else:
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:   https://s3.<region>.backblazeb2.com
#   MinIO:          http://127.0.0.1:9000
S3_ENDPOINT=

# The bucket's access key pair. S3_SECRET_ACCESS_KEY is a secret: it belongs
# here and in the Render dashboard, never in client/.env and never in git.
# Scope the key to this one bucket - it does not need account-wide access.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bucket in the path (endpoint/bucket/key) instead of the hostname. What R2,
# MinIO and most non-AWS implementations want. Ignored when S3_ENDPOINT is blank,
# because AWS deprecated path-style addressing.
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# mock     - checkout is runnable with no Razorpay account. Orders and
#            subscriptions get local `mock_` ids, and the webhook is signed with
#            the same secret the server verifies against - so the signature
#            check, the replay guard, the ledger row and the balance change are
#            all the real production code. It never moves money and never leaves
#            the machine. The billing page shows a "simulate payment" button
#            instead of opening Razorpay Checkout.
# razorpay - talks to Razorpay. Test mode and live mode are the SAME code path:
#            the mode is a property of the key pair, not of this setting. Switch
#            to live by swapping rzp_test_ keys for rzp_live_ keys.
PAYMENT_PROVIDER=mock

# From Razorpay Dashboard > Account & Settings > API Keys.
# The key id is public - the browser needs it to open Checkout, and the API
# returns it with the catalog. It is not a secret, but it does identify your
# account, so the test and live values must not be mixed up.
RAZORPAY_KEY_ID=

# Shown ONCE when you generate the key pair, and never again. Signs API calls
# and verifies the signature Checkout hands back. A secret.
RAZORPAY_KEY_SECRET=

# A DIFFERENT secret from the one above. You choose it yourself when you add the
# webhook in Razorpay Dashboard > Settings > Webhooks, and it is what proves a
# delivery came from Razorpay rather than from anyone who found the URL.
#
# Required when PAYMENT_PROVIDER=razorpay, and the server refuses to boot without
# it - because the webhook is the only thing in this system that grants purchased
# credits, so an unverified webhook is a free credit endpoint.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Hardening
# ---------------------------------------------------------------------------

# Largest JSON body accepted, in any format express.json understands (100kb,
# 1mb). The biggest legitimate request is a TTS call at TTS_MAX_INPUT_BYTES -
# under 5 KB - plus a few short fields, so this is roughly 20x headroom.
JSON_BODY_LIMIT=100kb

# Rate limiting on or off. Counted in this process's memory, not Redis: this is
# a single instance, so a per-process counter IS the global counter.
# Automatically off under `node --test`, where the suite deliberately fires
# hundreds of logins from one address.
RATE_LIMIT_ENABLED=true

# The window all four limits below are counted over, in minutes.
RATE_LIMIT_WINDOW_MINUTES=15

# Per IP, on the credential endpoints only - login, signup, verify, resend,
# forgot-password, reset-password. Low, because these are the ones worth brute
# forcing. /refresh and /me are deliberately NOT counted: they run on every page
# load, and limiting them would sign active users out.
RATE_LIMIT_AUTH_MAX=20

# Per user, on speech generation. Every generation spends real provider money, so
# this is a spend ceiling as much as an abuse one.
RATE_LIMIT_TTS_MAX=40

# Per user, on order and subscription creation. A created order is a row in
# Razorpay's system too, so a loop here makes a mess in their dashboard as well
# as ours.
RATE_LIMIT_PAYMENT_MAX=20

# Per IP, across the whole API, as a backstop. Generous on purpose: a normal
# session's page loads, polls, refreshes and audio fetches are all counted here,
# and a limit that catches real use is worse than no limit at all.
# The webhook path is not subject to this - Razorpay retries from its own
# addresses, and a burst of retries after an outage is exactly when the webhook
# must not be refused.
RATE_LIMIT_API_MAX=600
