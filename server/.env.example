# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored and must never be committed.
#
# In production these are set in the Render dashboard, not in a file.
# See docs/DEPLOYMENT.md.

# development | test | production
NODE_ENV=development

# Port the API listens on.
# Render injects its own PORT and the server uses whatever it is given, so this
# only matters locally.
PORT=4000

# MongoDB connection string. Required - the server has no default.
#   Local:  mongodb://127.0.0.1:27017/tts-saas
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tts-saas?retryWrites=true&w=majority
# URL-encode any special characters in the password (@ becomes %40).
MONGODB_URI=mongodb://127.0.0.1:27017/tts-saas

# The canonical frontend origin (no trailing slash). Used for CORS now, and for
# links in emails from Phase 3.
#   Local:       http://localhost:5173
#   Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Optional. Extra browser origins allowed through CORS, comma-separated.
# Exists for Vercel preview deployments, which get a new hostname per branch:
#   CORS_EXTRA_ORIGINS=https://tts-saas-git-my-branch-you.vercel.app
# Leave empty locally.
CORS_EXTRA_ORIGINS=

# error | warn | info | debug
LOG_LEVEL=info
