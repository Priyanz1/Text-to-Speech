# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored and must never be committed.
#
# In production these are set in the Render dashboard, not in a file.
# See docs/DEPLOYMENT.md.

# development | test | production
NODE_ENV=development

# Port the API listens on.
# Render injects its own PORT and the server uses whatever it is given, so this
# only matters locally.
PORT=4000

# MongoDB connection string. Required - the server has no default.
#   Local:  mongodb://127.0.0.1:27017/tts-saas
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tts-saas?retryWrites=true&w=majority
# URL-encode any special characters in the password (@ becomes %40).
MONGODB_URI=mongodb://127.0.0.1:27017/tts-saas

# The canonical frontend origin (no trailing slash). Used for CORS now, and for
# links in emails from Phase 3.
#   Local:       http://localhost:5173
#   Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Optional. Extra browser origins allowed through CORS, comma-separated.
# Exists for Vercel preview deployments, which get a new hostname per branch:
#   CORS_EXTRA_ORIGINS=https://tts-saas-git-my-branch-you.vercel.app
# Leave empty locally.
CORS_EXTRA_ORIGINS=

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signs access tokens. Required, with no fallback: anyone who knows this value
# can mint a token for any account, including an admin one.
# Generate a fresh one per environment - never reuse your local value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it invalidates every access token, which is the emergency lever if
# it ever leaks.
JWT_SECRET=

# How long an access token stays valid. Short by design - these cannot be
# revoked, so this window is also how long a stolen one keeps working.
ACCESS_TOKEN_TTL=15m

# How long a session can go unused before the user has to sign in again.
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt work factor. Higher is slower to hash and slower to crack. 12 is a
# reasonable default; do not lower it in production to make logins feel faster.
BCRYPT_COST=12

# How long emailed links stay valid, in minutes. 1440 = 24 hours.
VERIFY_TOKEN_TTL_MINUTES=1440
RESET_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# log    - prints the email, link included, to the server log. Right for local
#          development: no domain, no DNS records, no API key needed. Copy the
#          link out of your terminal.
# resend - actually delivers it. Requires RESEND_API_KEY.
EMAIL_PROVIDER=log

# Sender address. onboarding@resend.dev works without a domain but can only
# deliver to your own Resend account's address. Real delivery needs your own
# verified domain with SPF and DKIM records.
EMAIL_FROM=AI Text-to-Speech <onboarding@resend.dev>

# Only needed when EMAIL_PROVIDER=resend. This is a secret - it belongs here and
# in the Render dashboard, never in client/.env.
RESEND_API_KEY=

# Optional override for the refresh cookie's SameSite attribute.
# Leave blank: it resolves to 'lax' in development and 'none' in production,
# which is what a Vercel client talking to a Render API needs. Set it to 'lax'
# only if you later serve both from one domain. See config/cookies.js.
COOKIE_SAMESITE=

# ---------------------------------------------------------------------------
# Speech generation
# ---------------------------------------------------------------------------

# mock   - a real, playable WAV (a two-tone chime) generated on this machine.
#          Right for local development: the credit reserve, the refund, the
#          storage round trip and the player are all exercised for real, with no
#          billing account and no network call. It is obviously not speech, which
#          is deliberate - a convincing mock is one you ship by accident.
# google - calls Google Cloud Text-to-Speech. Requires
#          GOOGLE_SERVICE_ACCOUNT_JSON, and costs money per character.
TTS_PROVIDER=mock

# A Google Cloud service-account key, needed only when TTS_PROVIDER=google.
#
# This is a private key. It belongs here and in the Render dashboard, never in
# client/.env and never in git. Paste either the whole JSON on one line, or its
# base64 form, which survives copy-paste and dashboard forms better:
#   node -e "console.log(require('fs').readFileSync('key.json','base64'))"
#
# The server never hands this or any Google token to the browser: the client
# talks only to this API, and this API talks to Google.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Where generated audio is kept. `local` writes files under the server process.
# Audio is never stored in MongoDB - see docs/DECISIONS.md.
STORAGE_PROVIDER=local

# Directory for generated audio, relative to the server package. Git-ignored.
# On a host with an ephemeral filesystem (Render's free plan included) this
# empties on every deploy and restart, so treat the files as a cache, not as
# storage you can rely on. The Generation record is the durable part.
GENERATED_AUDIO_DIR=tmp/audio

# Largest request Google will accept, in UTF-8 BYTES, not characters. Google's
# own ceiling is 5000; this sits under it. Bytes and characters differ for any
# non-ASCII text - "café" is 4 characters and 5 bytes, and Hindi or Japanese run
# roughly three bytes per character. Credits are charged per CHARACTER, so a
# Hindi user is not billed three times for the same sentence.
TTS_MAX_INPUT_BYTES=4800
